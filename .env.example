# AWS Amplify Gen 2 - Environment Configuration
# Copy this file to .env and fill in your values (optional - AWS CLI profile is recommended)

# ============================================
# AWS Credentials (OPTION 1: Environment Variables)
# ============================================
# Note: Using AWS CLI profiles is recommended over environment variables
# Configure profile with: npx ampx configure profile
#
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_REGION=us-east-1

# ============================================
# AWS Profile (OPTION 2: Use AWS CLI Profile - RECOMMENDED)
# ============================================
# Set this to use a specific AWS profile configured in ~/.aws/credentials
# AWS_PROFILE=amplify-dev

# ============================================
# Amplify Configuration
# ============================================
# Default region for Amplify resources
AWS_REGION=us-east-1

# Amplify app name (optional, defaults to package.json name)
# AMPLIFY_APP_NAME=secretlittlemonkey

# ============================================
# How to Set Up:
# ============================================
# 1. Configure AWS credentials:
#    npx ampx configure profile
#    (This creates an AWS profile in ~/.aws/credentials)
#
# 2. Deploy Amplify sandbox:
#    npm run sandbox
#    (Generates amplify_outputs.json with API endpoints)
#
# 3. The React Native app will auto-detect amplify_outputs.json
#
# ============================================
# Security Notes:
# ============================================
# - Never commit .env files with real credentials
# - amplify_outputs.json contains API keys and is in .gitignore
# - Use AWS IAM roles with minimal permissions
# - API keys expire in 7 days (configured in amplify/data/resource.ts)
